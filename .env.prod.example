# ===================================================================
# GYMNASION - MODELO DE VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# ===================================================================
# Copie este arquivo para .env no servidor de produção e preencha os valores.

# Database Credentials
POSTGRES_DB=gymnasion_db
POSTGRES_USER=gymnasion_prod_user
POSTGRES_PASSWORD=sua_senha_forte_do_postgres_aqui

# Server Configuration
SERVER_PORT=8080
CONTEXT_PATH=/api
SPRING_PROFILES_ACTIVE=prod

# Security JWT Configuration (Gere uma chave hexadecimal segura de 64 caracteres)
JWT_SECRET=sua_chave_jwt_secreta_e_longa_de_producao
JWT_EXPIRATION_MS=86400000

# Default Admin User
ADMIN_EMAIL=admin@gymnasion.com.br
ADMIN_PASSWORD=sua_senha_admin_forte

# CORS / Frontend Configuration (URL real de produção)
FRONTEND_URL=https://gymnasion.com.br

# STRAVA CONFIGURATION
STRAVA_CLIENT_ID=seu_client_id_strava
STRAVA_CLIENT_SECRET=seu_client_secret_strava
STRAVA_REDIRECT_URI=https://gymnasion.com.br/strava/callback

# MAIL / SMTP - RESEND EM PRODUÇÃO
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_sua_api_key_do_resend_aqui
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=Gymnasion <nao-responda@gymnasion.com.br>

# NOTIFICACOES
NOTIF_PENDENTES_ENABLED=true
