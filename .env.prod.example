# Copie para .env na VPS e preencha. Nunca versione o .env real.

# Tag da imagem no GHCR (latest, sha-xxxxxxx ou X.Y.Z)
IMAGE_TAG=latest
APP_PORT=8080
APP_MEM_LIMIT=768m
CONTEXT_PATH=/api

# Banco de dados
POSTGRES_DB=gymnasion_db
POSTGRES_USER=gymnasion_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# JWT (gere com: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Usuário ADMIN criado no primeiro start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública do front (usada nos links dos e-mails). Uma única URL.
FRONTEND_URL=https://app.seudominio.com
# Origens do CORS separadas por vírgula. Vazio = usa o FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# SMTP real (ex.: Brevo, Resend, SES, Gmail com senha de app)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@seudominio.com

# Strava (opcional; sem client-id/secret a integração fica indisponível)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://app.seudominio.com/strava/callback
